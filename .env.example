# ADA Seller-Exhaustion Backtesting Tool

# Optional: suppress pyenv py2app/pkg_resources warning (see AGENTS.md v4.1)
# PYTHONWARNINGS=ignore::UserWarning:py2app,ignore:pkg_resources is deprecated:UserWarning

# API Configuration
POLYGON_API_KEY=
OPENAI_API_KEY=
REGIME_LLM_MODEL=gpt-4o-mini
DATA_DIR=.data
TZ=UTC

# Timeframe Configuration
TIMEFRAME=15
TIMEFRAME_UNIT=minute

# Last Data Download
LAST_TICKER=X:ADAUSD
LAST_DATE_FROM=2024-01-01
LAST_DATE_TO=2024-12-31

# Strategy Parameters
STRATEGY_EMA_FAST=96
STRATEGY_EMA_SLOW=672
STRATEGY_Z_WINDOW=672
STRATEGY_VOL_Z=2.0
STRATEGY_TR_Z=1.2
STRATEGY_CLOC_MIN=0.6
STRATEGY_ATR_WINDOW=96

# Backtest Parameters
BACKTEST_ATR_STOP_MULT=0.7
BACKTEST_REWARD_R=2.0
BACKTEST_MAX_HOLD=96
BACKTEST_FEE_BP=5.0
BACKTEST_SLIPPAGE_BP=5.0

# Optimizer Parameters
OPTIMIZER_ITERATIONS=50

# Genetic Algorithm Parameters
GA_POPULATION_SIZE=24
GA_MUTATION_RATE=0.3
GA_SIGMA=0.1
GA_ELITE_FRACTION=0.1
GA_TOURNAMENT_SIZE=3
GA_MUTATION_PROBABILITY=0.9

# Parallel CPU Workers (1 = single-threaded evaluation)
OPTIMIZER_WORKERS=7

# Logging
ADA_AGENT_LOG_LEVEL=INFO
LOG_PROGRESS_BARS=True
LOG_FEATURE_BUILDS=False

# Chart Indicator Display
CHART_EMA_FAST=True
CHART_EMA_SLOW=True
CHART_SMA=False
CHART_RSI=False
CHART_MACD=False
CHART_VOLUME=False
CHART_SIGNALS=True
CHART_ENTRIES=True
CHART_EXITS=True

# Chart View State
CHART_X_MIN=
CHART_X_MAX=
CHART_Y_MIN=
CHART_Y_MAX=

# Window State
WINDOW_WIDTH=1600
WINDOW_HEIGHT=1000
SPLITTER_LEFT=1120
SPLITTER_RIGHT=480
